# Bu dosyayı .env olarak kopyala: `unitakip init` bunu otomatik yapar ve anahtar üretir.
# .env git'e EKLENMEZ (.gitignore). İzinler: chmod 600 .env

# Oturum ve token şifreleme anahtarı (Fernet). `unitakip init` üretir. Kaybedersen yeniden giriş gerekir.
UNITAKIP_MASTER_KEY=

# Bildirimlerin gideceği adres (Gmail adresin)
UNITAKIP_NOTIFY_TO=

# İsteğe bağlı: Anthropic API anahtarı. Yalnızca config'te ai.provider=anthropic VE ai.allow_paid=true ise kullanılır.
ANTHROPIC_API_KEY=

# İsteğe bağlı geçersiz kılmalar
# UNITAKIP_CONFIG=config/config.yaml
# UNITAKIP_DATA_DIR=data
# UNITAKIP_LOG_LEVEL=INFO
